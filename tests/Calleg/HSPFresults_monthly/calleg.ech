 USERS CONTROL INPUT IS:
     NETWORK                                                                         
     <-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Target vols> <-Grp> <-Member->  ***
     <Name>   #        <Name> # #<-factor->strg <Name>   #   #        <Name> # #  ***
     *** Sum outflows from reaches to compare at respective downstream gage          
     *** Beardsley SIMQ (use gate 1 which is passed DS)                              
     RCHRES 502 HYDR   OVOL   1                 COPY   780     INPUT  MEAN   1       
     RCHRES 512 HYDR   OVOL   1                 COPY   780     INPUT  MEAN   1       
     *** FLOW                                                                        
     RCHRES 502 HYDR   O      1            AVER COPY   780     INPUT  MEAN   2       
     RCHRES 512 HYDR   O      1            AVER COPY   780     INPUT  MEAN   2       
     *** Arroyo Conejo below Conejo Blvd FLOW                                        
     RCHRES 401 HYDR   RO                  AVER COPY   836     INPUT  MEAN   1       
     RCHRES 411 HYDR   RO                  AVER COPY   836     INPUT  MEAN   1       
                                                                                     
     *** FLOW                                                                        
     RCHRES 207 HYDR   O      1            AVER COPY   207     INPUT  MEAN   1       
     RCHRES 233 HYDR   RO                  AVER COPY   207     INPUT  MEAN   1       
     RCHRES 243 HYDR   RO                  AVER COPY   207     INPUT  MEAN   1       
                                                                                     
     **** SENDING SUM OF CHANNEL LOSSES TO COPY                                      
     *** Lower Simi/Los Posas                                                        
     RCHRES 201 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   1       
     RCHRES 202 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   1       
     RCHRES 203 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   1       
     RCHRES 204 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   1       
     RCHRES 205 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   1       
     RCHRES 206 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   1       
     RCHRES 207 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   1       
     *** Lower Calleguas Creek                                                       
     RCHRES 301 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   2       
     RCHRES 302 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   2       
     RCHRES 303 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   2       
     RCHRES 304 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   2       
     RCHRES 305 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   2       
     RCHRES 306 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   2       
     RCHRES 307 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   2       
     *** Revolon Slough                                                              
     RCHRES 500 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   3       
     RCHRES 501 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   3       
     RCHRES 502 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   3       
     RCHRES 510 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   3       
     RCHRES 511 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   3       
     RCHRES 512 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   3       
     *** Upper Arroyo Simi                                                           
     RCHRES   2 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   4       
     RCHRES   3 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   4       
     RCHRES   4 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   4       
     RCHRES 904 HYDR   OVOL   2                 COPY   100     INPUT  MEAN   4       
                                                                                     
     END NETWORK                                                                     
 
 USERS CONTROL INPUT IS:
     EXT TARGETS                                                                     
     <-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Volume-> <Member> Tsys Aggr Amd ***
     <Name>   x        <Name> x x<-factor->strg <Name>   x <Name>qf  tem strg strg***
     *** HSPEXP Timeseries are stored in the WDM as daily with TSFORM=1 (mean)       
     *** The default aggregration for mean to mean when sdelt < tdelt is sum,        
     *** thus all timsers are summed to inches/day                                   
     *** Reaches 301 and 205 only pass flows from gate 1 downstream                  
     RCHRES 904 HYDR   OVOL   1 1 5.9049e-4     WDM   9101 SIMQ   1 ENGL AGGR REPL   
     RCHRES   8 ROFLOW ROVOL  1 1 2.6707e-4     WDM   9201 SIMQ   1 ENGL AGGR REPL   
     RCHRES 302 HYDR   OVOL   1 1 1.1208e-4     WDM   9501 SIMQ   1 ENGL AGGR REPL   
     RCHRES 405 ROFLOW ROVOL  1 1 2.9174e-4     WDM   9301 SIMQ   1 ENGL AGGR REPL   
     RCHRES 304 HYDR   OVOL   1 1 7.5153e-5     WDM   9601 SIMQ   1 ENGL AGGR REPL   
     RCHRES 505 ROFLOW ROVOL  1 1 4.0879e-4     WDM   9401 SIMQ   1 ENGL AGGR REPL   
     RCHRES 205 HYDR   OVOL   1 1 1.4626e-4     WDM   9701 SIMQ   1 ENGL AGGR REPL   
     *** Beardsley drainage area includes Both Reaches 502 and 512                   
     COPY   780 OUTPUT MEAN   1 1 7.3582e-4     WDM   9801 SIMQ   1 ENGL AGGR REPL   
                                                                                     
     COPY     1 OUTPUT MEAN   1 1 4.9208e-5     WDM   9102 SURO   1 ENGL AGGR REPL   
     COPY     1 OUTPUT MEAN   2 1 4.9208e-5     WDM   9103 IFWO   1 ENGL AGGR REPL   
     *** AGWO above Royal is routed downstream (i.e., MFACT = 0.0)                   
     COPY     1 OUTPUT MEAN   3 1       0.0     WDM   9104 AGWO   1 ENGL AGGR REPL   
     COPY     1 OUTPUT MEAN   4 1 4.9208e-5     WDM   9105 PETX   1 ENGL AGGR REPL   
     COPY     1 OUTPUT MEAN   5 1 4.9208e-5     WDM   9106 SAET   1 ENGL AGGR REPL   
     COPY     1 OUTPUT MEAN   6 1 4.9208e-5AVER WDM   9107 UZSX   1 ENGL AGGR REPL   
     COPY     1 OUTPUT MEAN   7 1 4.9208e-5AVER WDM   9108 LZSX   1 ENGL AGGR REPL   
     COPY     1 OUTPUT MEAN   8 1 4.9208e-5     WDM   9109 WPPT   1 ENGL AGGR REPL   
     COPY     2 OUTPUT MEAN   1 1 2.2256e-5     WDM   9202 SURO   1 ENGL AGGR REPL   
