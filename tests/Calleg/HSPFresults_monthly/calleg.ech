       END MASS-LINK    1                                                            
                                                                                     
       MASS-LINK       11                                                            
     <-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Target vols> <-Grp> <-Member->  ***
     <Name>            <Name> x x<-factor->strg <Name>                <Name> x x  ***
     PERLND     PWATER SURO       0.0833333     RCHRES         INFLOW IVOL           
     PERLND     PWATER IFWO       0.0833333     RCHRES         INFLOW IVOL           
       END MASS-LINK   11                                                            
                                                                                     
       MASS-LINK       21                                                            
     <-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Target vols> <-Grp> <-Member->  ***
     <Name>            <Name> x x<-factor->strg <Name>                <Name> x x  ***
     PERLND     PWATER AGWO       0.0833333     RCHRES         INFLOW IVOL           
       END MASS-LINK   21                                                            
                                                                                     
     *** Reaches above Beardsley in Segment 28 will route 30% of their AGWO to gage  
     *** and pass under 70% of their AGWO (MFACT = 0.0833333 * .7 = 5.83333e-2)      
     *** DAs to reaches 502,510,511,and 512 will have 70% of AGWO routed to 503      
     *** ML 31 used for above gage and 41 used for AGWO bypassed                     
       MASS-LINK       31                                                            
     <-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Target vols> <-Grp> <-Member->  ***
     <Name>            <Name> x x<-factor->strg <Name>                <Name> x x  ***
     PERLND     PWATER SURO       0.0833333     RCHRES         INFLOW IVOL           
     PERLND     PWATER IFWO       0.0833333     RCHRES         INFLOW IVOL           
     PERLND     PWATER AGWO       0.0250000     RCHRES         INFLOW IVOL           
       END MASS-LINK   31                                                            
                                                                                     
       MASS-LINK       41                                                            
     <-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Target vols> <-Grp> <-Member->  ***
     <Name>            <Name> x x<-factor->strg <Name>                <Name> x x  ***
     PERLND     PWATER AGWO       5.8333e-2     RCHRES         INFLOW IVOL           
       END MASS-LINK   41                                                            
                                                                                     
       MASS-LINK        2                                                            
     <-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Target vols> <-Grp> <-Member->  ***
     <Name>            <Name> x x<-factor->strg <Name>                <Name> x x  ***
     IMPLND     IWATER SURO       0.0833333     RCHRES         INFLOW IVOL           
       END MASS-LINK    2                                                            
                                                                                     
       MASS-LINK        3                                                            
     <-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Target vols> <-Grp> <-Member->  ***
     <Name>            <Name> x x<-factor->strg <Name>                <Name> x x  ***
     RCHRES     ROFLOW                          RCHRES         INFLOW                
       END MASS-LINK    3                                                            
                                                                                     
     *** ML 4 passes flow from gate 1 DS w/o the stream channel or diversion losses  
       MASS-LINK        4                                                            
     <-Volume-> <-Grp> <-Member-><--Mult-->Tran <-Target vols> <-Grp> <-Member->  ***
     <Name>            <Name> x x<-factor->strg <Name>                <Name> x x  ***
     RCHRES     HYDR   OVOL   1                 RCHRES         INFLOW IVOL           
       END MASS-LINK    4                                                            
                                                                                     
       MASS-LINK       90                                                            
     <-Volume-> <-Grp> <-Member-><--Mult-->     <-Target vols> <-Grp> <-Member->  ***
     <Name>            <Name> x x<-factor->     <Name>                <Name> x x  ***
     PERLND     PWATER SURO                     COPY           INPUT  MEAN   1       
     PERLND     PWATER IFWO                     COPY           INPUT  MEAN   2       
     PERLND     PWATER AGWO                     COPY           INPUT  MEAN   3       
     PERLND     PWATER PET                      COPY           INPUT  MEAN   4       
     PERLND     PWATER TAET                     COPY           INPUT  MEAN   5       
     PERLND     PWATER UZS                      COPY           INPUT  MEAN   6       
     PERLND     PWATER LZS                      COPY           INPUT  MEAN   7       
     PERLND     PWATER SUPY                     COPY           INPUT  MEAN   8       
       END MASS-LINK   90                                                            
                                                                                     
       MASS-LINK       91                                                            
     <-Volume-> <-Grp> <-Member-><--Mult-->     <-Target vols> <-Grp> <-Member->  ***
     <Name>            <Name> x x<-factor->     <Name>                <Name> x x  ***
     IMPLND     IWATER SURO                     COPY           INPUT  MEAN   1       
     IMPLND     IWATER PET                      COPY           INPUT  MEAN   4       
     IMPLND     IWATER IMPEV                    COPY           INPUT  MEAN   5       
     IMPLND     IWATER SUPY                     COPY           INPUT  MEAN   8       
       END MASS-LINK   91                                                            
     END MASS-LINK                                                                   

